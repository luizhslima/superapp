{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "superapp",
  "version": "0.0.0",
  "identifier": "dev.superapp.app",
  "build": { "frontendDist": "../ui/shell" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Superapp", "url": "index.html", "width": 1000, "height": 700 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-hashes' 'sha256-YEercZJImS+vUX2bz7vkQ0aA4rtBIPLuCEWz+yraQ/g='; img-src 'self' data:; connect-src ipc: http://ipc.localhost sapp: http://sapp.localhost",
      "pattern": { "use": "isolation", "options": { "dir": "../ui/isolation" } }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Superapp: host híbrido de mini-apps",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
