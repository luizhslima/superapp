{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "superapp",
  "version": "0.0.0",
  "identifier": "dev.superapp.app",
  "build": { "frontendDist": "../ui/shell" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Superapp", "url": "index.html", "width": 1000, "height": 700 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "pattern": { "use": "isolation", "options": { "dir": "../ui/isolation" } }
    }
  },
  "bundle": { "active": false }
}
